#!/bin/bash
# Managed by dotfiles/install.sh — global post-commit hook
# Chains into the local repo's post-commit hook if one exists.

git_common_dir="$(git rev-parse --git-common-dir 2>/dev/null)"
if [[ -n "$git_common_dir" ]]; then
  local_hook="$git_common_dir/hooks/post-commit"
  if [[ -x "$local_hook" ]]; then
    "$local_hook" "$@"
    exit $?
  fi
fi
